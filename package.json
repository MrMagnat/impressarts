{
  "name": "sklad-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Веб-дашборд управления складскими запасами (данные из 1С)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "etl": "npm run etl --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
