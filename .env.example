# ===== Складской дашборд · настройки продакшена =====
# Скопируйте в .env и заполните. Файл .env НЕ коммитить.

# --- доступ ---
AUTH_PASSWORD=ЗАМЕНИТЕ_НА_СИЛЬНЫЙ_ПАРОЛЬ
COOKIE_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_32+
PORT=3000
HOST=0.0.0.0

# --- ЛИЦЕНЗИЯ / ВЫКЛЮЧАТЕЛЬ (главное для контроля клиента) ---
# URL, который контролируете ВЫ (ваш VPS / GitHub Gist raw / S3). Туда кладёте
# подписанную license.json. Чтобы отключить клиента — публикуете license с
# "active": false (или даёте сроку истечь). Приложение блокируется в течение
# LICENSE_POLL_MIN минут. Если URL недоступен дольше LICENSE_GRACE_HOURS — тоже блок.
LICENSE_URL=https://example.com/impress-sklad/license.json

# Публичный ключ поставщика (base64). По умолчанию уже вшит в код —
# переопределяйте только при ротации ключей.
# LICENSE_PUBKEY=

LICENSE_POLL_MIN=15
LICENSE_GRACE_HOURS=72
LICENSE_REQUIRED=true

# Оффлайн-вариант вместо URL (если у клиента нет исходящего интернета):
# положите подписанный файл в volume и укажите путь. «Выключить» = заменить файл.
# LICENSE_FILE=/app/data/license.json
